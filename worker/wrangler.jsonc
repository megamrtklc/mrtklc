{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cineverse-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "../admin",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "GITHUB_OWNER": "megamrtklc",
    "GITHUB_REPO": "mrtklc",
    "GITHUB_BRANCH": "main",
    "GITHUB_CATALOG_PATH": "filmvediziler.json"
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
